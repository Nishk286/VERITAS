@page
@model VERITAS.Pages.IndexModel

@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     HERO SECTION
========================= -->

<section class="veritas-hero">

    <div class="hero-content">

        <span class="section-label">
            EVIDENCE INTELLIGENCE PLATFORM
        </span>

        <h1>
            See beyond the
            <span class="hero-accent">headline.</span>
        </h1>

        <p class="hero-description">
            Analyze claims, examine evidence, and make
            better-informed decisions with VERITAS.
        </p>

        <div class="hero-actions">

            <a asp-page="/CheckNews"
               class="primary-button">
                Analyze a Claim
            </a>

            <a asp-page="/MediaLiteracy"
               class="secondary-button">
                Explore Media Literacy
            </a>

        </div>

        <div class="hero-trust">

            <span class="trust-dot"></span>

            <span>
                Evidence-first verification
            </span>

        </div>

    </div>


    <!-- =========================
         HERO INTELLIGENCE VISUAL
    ========================= -->

    <div class="hero-visual">

        <div class="intelligence-orb">

            <div class="orb-core">
                V
            </div>

            <div class="orb-ring ring-one"></div>
            <div class="orb-ring ring-two"></div>
            <div class="orb-ring ring-three"></div>

            <div class="orb-node node-one"></div>
            <div class="orb-node node-two"></div>
            <div class="orb-node node-three"></div>

        </div>


        <div class="visual-card visual-card-top">

            <span class="visual-icon">
                E
            </span>

            <div>
                <strong>
                    Evidence
                </strong>

                <small>
                    Not assumptions
                </small>
            </div>

        </div>


        <div class="visual-card visual-card-bottom">

            <span class="visual-icon">
                V
            </span>

            <div>
                <strong>
                    Verification
                </strong>

                <small>
                    Before you share
                </small>
            </div>

        </div>


        <div class="visual-status">

            <span class="status-indicator"></span>

            <span>
                ANALYSIS ENGINE
            </span>

            <strong>
                READY
            </strong>

        </div>

    </div>

</section>


<!-- =========================
     VERIFICATION PROTOCOL
========================= -->

<section class="verification-section">

    <div class="section-heading">

        <span class="section-label">
            VERIFICATION PROTOCOL
        </span>

        <h2>
            From claim to conclusion.
        </h2>

        <p>
            VERITAS follows an evidence-first workflow
            to help users understand what supports,
            contradicts, or remains uncertain about a claim.
        </p>

    </div>


    <div class="verification-flow">

        <!-- STEP 01 -->

        <div class="flow-step">

            <span class="step-number">
                01
            </span>

            <div class="step-icon">
                C
            </div>

            <h3>
                Claim
            </h3>

            <p>
                Identify the exact statement being examined.
            </p>

        </div>


        <div class="flow-line"></div>


        <!-- STEP 02 -->

        <div class="flow-step">

            <span class="step-number">
                02
            </span>

            <div class="step-icon">
                A
            </div>

            <h3>
                Analysis
            </h3>

            <p>
                Examine the claim using available analysis methods.
            </p>

        </div>


        <div class="flow-line"></div>


        <!-- STEP 03 -->

        <div class="flow-step">

            <span class="step-number">
                03
            </span>

            <div class="step-icon">
                E
            </div>

            <h3>
                Evidence
            </h3>

            <p>
                Retrieve and examine relevant supporting evidence.
            </p>

        </div>


        <div class="flow-line"></div>


        <!-- STEP 04 -->

        <div class="flow-step">

            <span class="step-number">
                04
            </span>

            <div class="step-icon">
                V
            </div>

            <h3>
                Verification
            </h3>

            <p>
                Compare the available evidence and sources.
            </p>

        </div>


        <div class="flow-line"></div>


        <!-- STEP 05 -->

        <div class="flow-step">

            <span class="step-number">
                05
            </span>

            <div class="step-icon">
                ✓
            </div>

            <h3>
                Verdict
            </h3>

            <p>
                TRUE, FALSE, or UNCERTAIN based on available evidence.
            </p>

        </div>

    </div>

</section>


<!-- =========================
     WHY VERITAS
========================= -->

<section class="principles-section">

    <div class="principles-header">

        <span class="section-label">
            WHY VERITAS
        </span>

        <h2>
            Designed for better decisions.
        </h2>

        <p>
            Verification should be based on evidence,
            transparent reasoning, and responsible uncertainty.
        </p>

    </div>


    <div class="principles-grid">

        <article class="principle-card">

            <span class="principle-number">
                01
            </span>

            <h3>
                Evidence First
            </h3>

            <p>
                Claims are evaluated against available evidence
                rather than assumptions or popularity.
            </p>

        </article>


        <article class="principle-card">

            <span class="principle-number">
                02
            </span>

            <h3>
                Source Awareness
            </h3>

            <p>
                Understanding where information comes from
                is an essential part of responsible verification.
            </p>

        </article>


        <article class="principle-card">

            <span class="principle-number">
                03
            </span>

            <h3>
                Honest Uncertainty
            </h3>

            <p>
                When reliable evidence is insufficient,
                VERITAS does not force a binary conclusion.
            </p>

        </article>

    </div>

</section>


<!-- =========================
     FINAL CTA
========================= -->

<section class="home-cta">

    <div>

        <span class="section-label">
            START VERIFYING
        </span>

        <h2>
            Don't just read the headline.
        </h2>

        <p>
            Examine the claim. Explore the evidence.
            Make a more informed decision.
        </p>

    </div>


    <a asp-page="/CheckNews"
       class="primary-button">
        Check a Claim
    </a>

</section>