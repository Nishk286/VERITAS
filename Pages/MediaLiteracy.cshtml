@page
@model VERITAS.Pages.MediaLiteracyModel

@{
    ViewData["Title"] = "Media Literacy";
}

<section class="literacy-page">

    <!-- HERO -->
    <div class="literacy-hero">

        <span class="section-label">
            MEDIA LITERACY
        </span>

        <h1>
            Think beyond<br />
            <span class="hero-accent">the headline.</span>
        </h1>

        <p>
            Learn practical methods for evaluating information,
            checking evidence, and recognizing misleading claims
            before accepting or sharing them.
        </p>

    </div>


    <!-- PRINCIPLES -->
    <div class="literacy-section">

        <div class="analysis-section-heading">
            <span>01</span>

            <div>
                <small>CORE PRINCIPLES</small>

                <h2>
                    Five questions to ask
                </h2>
            </div>
        </div>


        <div class="result-grid">

            <article class="result-card">

                <div class="result-card-number">
                    01
                </div>

                <span class="result-card-label">
                    SOURCE
                </span>

                <h3>
                    Who published it?
                </h3>

                <p>
                    Identify the original publisher, author, or
                    organization. Check whether the source provides
                    clear information about its identity and purpose.
                </p>

            </article>


            <article class="result-card">

                <div class="result-card-number">
                    02
                </div>

                <span class="result-card-label">
                    EVIDENCE
                </span>

                <h3>
                    What evidence supports it?
                </h3>

                <p>
                    Look for verifiable evidence rather than relying
                    only on opinions, screenshots, headlines, or
                    unsupported statements.
                </p>

            </article>


            <article class="result-card">

                <div class="result-card-number">
                    03
                </div>

                <span class="result-card-label">
                    CONTEXT
                </span>

                <h3>
                    Is the context complete?
                </h3>

                <p>
                    Check dates, locations, quotations, statistics,
                    and surrounding information. A real fact can still
                    become misleading when important context is removed.
                </p>

            </article>


            <article class="result-card">

                <div class="result-card-number">
                    04
                </div>

                <span class="result-card-label">
                    CROSS-CHECK
                </span>

                <h3>
                    Do other sources agree?
                </h3>

                <p>
                    Compare important claims with independent and
                    credible sources. Multiple reports can provide
                    useful context, but repetition alone does not prove
                    a claim.
                </p>

            </article>


            <article class="result-card">

                <div class="result-card-number">
                    05
                </div>

                <span class="result-card-label">
                    INTENT
                </span>

                <h3>
                    What is the content trying to do?
                </h3>

                <p>
                    Consider whether the content is informing,
                    persuading, entertaining, selling, or provoking
                    an emotional reaction.
                </p>

            </article>

        </div>

    </div>


    <!-- RED FLAGS -->
    <div class="literacy-section">

        <div class="analysis-section-heading">
            <span>02</span>

            <div>
                <small>WARNING SIGNS</small>

                <h2>
                    Signals worth checking
                </h2>
            </div>
        </div>


        <div class="result-grid">

            <article class="result-card">

                <span class="result-card-label">
                    EMOTIONAL LANGUAGE
                </span>

                <h3>
                    Extreme or provocative wording
                </h3>

                <p>
                    Strong emotional language can encourage immediate
                    reactions. Pause and verify the underlying claim
                    before sharing.
                </p>

            </article>


            <article class="result-card">

                <span class="result-card-label">
                    MISSING SOURCES
                </span>

                <h3>
                    No identifiable evidence
                </h3>

                <p>
                    Be cautious when a major factual claim provides no
                    source, document, data, quotation, or other way to
                    verify the information.
                </p>

            </article>


            <article class="result-card">

                <span class="result-card-label">
                    OLD CONTENT
                </span>

                <h3>
                    Outdated information presented as new
                </h3>

                <p>
                    Check the publication date and original context.
                    Older photographs, videos, or reports can be
                    recirculated with a different interpretation.
                </p>

            </article>


            <article class="result-card">

                <span class="result-card-label">
                    VISUAL CONTENT
                </span>

                <h3>
                    Images are not automatically proof
                </h3>

                <p>
                    Images and videos can be authentic while still
                    being presented with an incorrect date, location,
                    caption, or interpretation.
                </p>

            </article>

        </div>

    </div>


    <!-- VERIFICATION CHECKLIST -->
    <div class="literacy-section">

        <div class="analysis-section-heading">
            <span>03</span>

            <div>
                <small>VERIFICATION CHECKLIST</small>

                <h2>
                    Before you share
                </h2>
            </div>
        </div>


        <div class="literacy-checklist">

            <div class="checklist-item">
                <span>01</span>
                <p>Read beyond the headline.</p>
            </div>

            <div class="checklist-item">
                <span>02</span>
                <p>Identify the original source.</p>
            </div>

            <div class="checklist-item">
                <span>03</span>
                <p>Check the publication date and context.</p>
            </div>

            <div class="checklist-item">
                <span>04</span>
                <p>Look for supporting evidence.</p>
            </div>

            <div class="checklist-item">
                <span>05</span>
                <p>
                    Compare important claims with independent sources.
                </p>
            </div>

            <div class="checklist-item">
                <span>06</span>
                <p>
                    Separate facts, opinions, and interpretations.
                </p>
            </div>

            <div class="checklist-item">
                <span>07</span>
                <p>
                    Consider what information may be missing.
                </p>
            </div>

            <div class="checklist-item">
                <span>08</span>
                <p>
                    Pause before sharing uncertain information.
                </p>
            </div>

        </div>

    </div>


    <!-- VERITAS PRINCIPLE -->
    <div class="literacy-principle">

        <span class="section-label">
            THE VERITAS PRINCIPLE
        </span>

        <h2>
            Evidence before influence.
        </h2>

        <p>
            The goal of verification is not simply to find an answer.
            It is to understand how confidently that answer can be
            supported by available evidence.
        </p>

        <a asp-page="/CheckNews"
           class="primary-button">
            Analyze a Claim
        </a>

    </div>

</section>


<style>

    /* =========================================================
       MEDIA LITERACY PAGE
       ========================================================= */

    .literacy-page {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
        padding: 72px 0 90px;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .literacy-hero {
        width: min(820px, 100%);
        margin: 0 auto 90px;
        text-align: center;
    }

    .literacy-hero h1 {
        margin: 18px 0 24px;
    }

    .literacy-hero p {
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.8;
    }


    /* =========================================================
       SECTIONS
       ========================================================= */

    .literacy-section {
        width: 100%;
        margin: 0 auto 90px;
    }

    .analysis-section-heading {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        width: 100%;
        margin-bottom: 32px;
    }

    .analysis-section-heading > span {
        flex: 0 0 auto;
        padding-top: 4px;
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        opacity: 0.55;
    }

    .analysis-section-heading small {
        display: block;
        margin-bottom: 7px;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        opacity: 0.55;
    }

    .analysis-section-heading h2 {
        margin: 0;
    }


    /* =========================================================
       CARDS
       ========================================================= */

    .literacy-page .result-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .literacy-page .result-card {
        min-width: 0;
        padding: 30px;
        border-radius: 16px;
    }

    .literacy-page .result-card h3 {
        margin-top: 12px;
        margin-bottom: 12px;
    }

    .literacy-page .result-card p {
        margin: 0;
        line-height: 1.75;
    }

    .literacy-page .result-card-number {
        margin-bottom: 18px;
    }


    /* =========================================================
       CHECKLIST
       ========================================================= */

    .literacy-checklist {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .checklist-item {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
        padding: 20px 22px;
        border-radius: 12px;
    }

    .checklist-item span {
        flex: 0 0 auto;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        opacity: 0.55;
    }

    .checklist-item p {
        margin: 0;
        line-height: 1.55;
    }


    /* =========================================================
       FINAL PRINCIPLE
       ========================================================= */

    .literacy-principle {
        width: min(850px, 100%);
        margin: 10px auto 0;
        padding: 54px 44px;
        text-align: center;
        border-radius: 18px;
    }

    .literacy-principle h2 {
        margin: 18px 0 16px;
    }

    .literacy-principle p {
        max-width: 650px;
        margin: 0 auto 28px;
        line-height: 1.8;
    }

    .literacy-principle .primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 900px) {

        .literacy-page {
            width: min(100% - 32px, 760px);
            padding-top: 56px;
        }

        .literacy-hero {
            margin-bottom: 68px;
        }

        .literacy-section {
            margin-bottom: 68px;
        }

        .literacy-page .result-grid {
            grid-template-columns: 1fr;
        }

        .literacy-checklist {
            grid-template-columns: 1fr;
        }
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 600px) {

        .literacy-page {
            width: calc(100% - 24px);
            padding: 42px 0 64px;
        }

        .literacy-hero {
            margin-bottom: 54px;
        }

        .literacy-hero h1 {
            font-size: clamp(2.3rem, 11vw, 3.2rem);
            line-height: 1.05;
        }

        .literacy-hero p {
            font-size: 0.94rem;
            line-height: 1.7;
        }

        .literacy-section {
            margin-bottom: 58px;
        }

        .analysis-section-heading {
            gap: 12px;
            margin-bottom: 22px;
        }

        .analysis-section-heading h2 {
            font-size: 1.45rem;
        }

        .literacy-page .result-grid {
            gap: 14px;
        }

        .literacy-page .result-card {
            padding: 23px 20px;
            border-radius: 14px;
        }

        .literacy-page .result-card p {
            font-size: 0.92rem;
            line-height: 1.65;
        }

        .literacy-checklist {
            gap: 10px;
        }

        .checklist-item {
            gap: 14px;
            padding: 17px 16px;
        }

        .checklist-item p {
            font-size: 0.92rem;
        }

        .literacy-principle {
            padding: 38px 22px;
            border-radius: 15px;
        }

        .literacy-principle h2 {
            font-size: 1.65rem;
        }

        .literacy-principle p {
            font-size: 0.92rem;
            line-height: 1.7;
        }

        .literacy-principle .primary-button {
            width: 100%;
        }
    }

</style>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}